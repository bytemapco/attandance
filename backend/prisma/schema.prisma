datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

generator client {
  provider             = "prisma-client-py"
  interface            = "asyncio"
  recursive_type_depth = 5
  previewFeatures      = ["postgresqlExtensions"]
}


// ==============================================================================
// ENUMS
// ==============================================================================

enum Role {
  STUDENT
  TEACHER
  ADMIN
  SUPER_ADMIN
  TENANT_ADMIN
}

enum Gender {
  M
  F
  O
}

enum CourseEnrollmentStatus {
  ACTIVE
  DROPPED
}

enum TenantType {
  SCHOOL
  COLLEGE
  COACHING_CENTER
  UNIVERSITY
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  TRIAL
  EXPIRED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  FLAGGED
  APPROVED
  EXCUSED
  LATE
}

enum AttendanceMethod {
  AI_BIOMETRIC
  QR_CODE
  SMART_PASS_OFFLINE
  MANUAL_OVERRIDE
  MANUAL_REGISTER
  SYSTEM_EXCUSED
}

enum AcademicPeriodStatus {
  PLANNING
  ACTIVE
  LOCKED
  ARCHIVED
}


enum OccurrenceStatus {
  SCHEDULED
  CONDUCTED
  CANCELLED
  RESCHEDULED
}

enum CalendarEventType {
  HOLIDAY
  EXAM_DAY
  NON_INSTRUCTIONAL
  TIMETABLE_OVERRIDE
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum DeviceStatus {
  ACTIVE
  REVOKED
}

enum DeviceChangeStatus {
  PENDING
  APPROVED
  REJECTED
}

enum LicenseRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

// ==============================================================================
// TENANTS & USERS
// ==============================================================================

/// An institution (school, college or university) using SAHAJ. Everything else belongs to one tenant.
model Tenant {
  id           String       @id @default(uuid())
  slug         String       @unique
  name         String
  type         TenantType   @default(COLLEGE)
  status       TenantStatus @default(ACTIVE)
  domain       String?      @unique
  licenseCount Int          @default(0) @map("license_count")
  settings     Json?        @default("{}")
  config       Json?
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  users           User[]
  students        Student[]
  teachers        Teacher[]
  departments     Department[]
  subjects        Subject[]
  classrooms      Classroom[]
  designations    Designation[]
  classes         AcademicClass[]
  timeSlots       TimeSlot[]
  attendance      Attendance[]
  auditLogs       AuditLog[]
  licenseRequests LicenseRequest[]
  notifications   Notification[]
  systemConfig    SystemConfiguration?

  academicYears     AcademicYear[]
  calendarEvents    AcademicCalendarEvent[]
  courseSections    CourseSection[]
  classOccurrences  ClassOccurrence[]
  attendanceRecords AttendanceRecord[]
  semesters         Semester[]
  studentGroups     StudentGroup[]
  batches           Batch[]
  classTerms        ClassTerm[]
  classMembers      ClassMember[]

  leaveRequests        LeaveRequest[]
  deviceChangeRequests DeviceChangeRequest[]
  studentBiometrics    StudentBiometric[]
  sessions             Session[]

  @@index([status])
  @@map("tenants")
}

/// A login. Students and teachers each have one User plus a Student or Teacher profile.
model User {
  id                 String    @id @default(uuid())
  tenantId           String?   @map("tenant_id")
  email              String    @unique
  hashedPassword     String    @map("hashed_password")
  role               Role      @default(STUDENT)
  isActive           Boolean   @default(true) @map("is_active")
  mustChangePassword Boolean   @default(false) @map("must_change_password")
  lastLoginAt        DateTime? @map("last_login_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  tenant                     Tenant?          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student                    Student?
  teacher                    Teacher?
  notifications              Notification[]
  licenseRequestsAsRequester LicenseRequest[] @relation("LicenseRequester")
  licenseRequestsAsProcessor LicenseRequest[] @relation("LicenseProcessor")
  attendanceAudits           AttendanceAuditLog[]

  @@index([tenantId, role])
  @@index([tenantId, isActive])
  @@map("users")
}

model Student {
  id               String    @id @default(uuid())
  tenantId         String?   @map("tenant_id")
  userId           String    @unique @map("user_id")
  departmentId     String    @map("department_id")
  enrollmentNumber String    @map("enrollment_number")
  firstName        String?   @map("first_name")
  lastName         String?   @map("last_name")
  phone            String?   @map("phone")
  gender           Gender?   @map("gender")
  dateOfBirth      DateTime? @map("date_of_birth") @db.Date
  semester         Int?      @map("semester")
  batch            String?   @map("batch")
  batchId          String?   @map("batch_id")
  deviceUuid       String?   @map("device_uuid")
  fcmToken         String?   @map("fcm_token")
  faceEmbedding    Unsupported("vector(128)")? @map("face_embedding")
  currentStreak    Int       @default(0) @map("current_streak")
  highestStreak    Int       @default(0) @map("highest_streak")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  tenant               Tenant?               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user                 User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  department           Department            @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  batchRef             Batch?                @relation(fields: [batchId], references: [id], onDelete: Restrict)
  biometrics           StudentBiometric[]
  enrollments          Enrollment[]
  attendanceRecords    Attendance[]
  leaveRequests        LeaveRequest[]
  deviceChangeRequests DeviceChangeRequest[]
  courseEnrollments    CourseEnrollment[]
  newAttendanceRecords AttendanceRecord[]
  classMemberships     ClassMember[]

  @@unique([enrollmentNumber])
  @@index([tenantId, departmentId])
  @@index([tenantId, createdAt])
  @@index([semester, batch])
  @@index([batchId])
  @@map("students")
}

/// A student's stored face template, with the consent flag recorded alongside it.
model StudentBiometric {
  id               String                     @id @default(uuid())
  tenantId         String?                    @map("tenant_id")
  studentId        String                     @map("student_id")
  algorithm        String                     @default("facenet_128")
  embeddingVersion Int                        @default(1) @map("embedding_version")
  faceEmbedding    Unsupported("vector(128)") @map("face_embedding")
  isActive         Boolean                    @default(true) @map("is_active")
  consentGiven     Boolean                    @default(true) @map("consent_given")
  createdAt        DateTime                   @default(now()) @map("created_at")
  updatedAt        DateTime                   @updatedAt @map("updated_at")

  tenant  Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, isActive])
  @@index([tenantId])
  @@map("student_biometrics")
}

model Teacher {
  id              String    @id @default(uuid())
  tenantId        String?   @map("tenant_id")
  userId          String    @unique @map("user_id")
  departmentId    String    @map("department_id")
  designationId   String    @map("designation_id")
  employeeId      String    @unique @map("employee_id")
  firstName       String    @map("first_name")
  lastName        String    @map("last_name")
  nameInitials    String?   @map("name_initials")
  phone           String?   @map("phone")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  tenant                Tenant?               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user                  User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  department            Department            @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  designation           Designation           @relation(fields: [designationId], references: [id], onDelete: Restrict)
  classes               AcademicClass[]
  facultyOccurrences    ClassOccurrence[]     @relation("FacultyOccurrences")
  substituteOccurrences ClassOccurrence[]     @relation("SubstituteOccurrences")
  courseFaculties       CourseFaculty[]
  timetableRules        TimetableRule[]

  @@index([tenantId, departmentId])
  @@map("teachers")
}

// ==============================================================================
// ACADEMIC SETUP (departments, subjects, rooms, periods)
// ==============================================================================

model Department {
  id          String   @id @default(uuid())
  tenantId    String?  @map("tenant_id")
  code        String
  name        String
  head        String?
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant   Tenant?          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  teachers Teacher[]
  students Student[]
  subjects Subject[]
  courseSections CourseSection[]
  studentGroups  StudentGroup[]
  batches        Batch[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("departments")
}

model Designation {
  id          String   @id @default(uuid())
  tenantId    String?  @map("tenant_id")
  code        String
  name        String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant   Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  teachers Teacher[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("designations")
}

model Subject {
  id           String   @id @default(uuid())
  tenantId     String?  @map("tenant_id")
  departmentId String?  @map("department_id")
  code         String
  name         String
  description  String?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  tenant          Tenant?          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  department      Department?      @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  classes         AcademicClass[]
  courseSections  CourseSection[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([departmentId])
  @@map("subjects")
}

model Classroom {
  id        String   @id @default(uuid())
  tenantId  String?  @map("tenant_id")
  name      String
  building  String?
  capacity  Int?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant           Tenant?          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  classes          AcademicClass[]
  courseSections   CourseSection[]
  occurrences      ClassOccurrence[]
  timetableRules   TimetableRule[]

  @@index([tenantId])
  @@map("classrooms")
}

model TimeSlot {
  id         String   @id @default(uuid())
  tenantId   String?  @map("tenant_id")
  slotNumber Int      @map("slot_number")
  name       String
  startTime  String   @map("start_time")
  endTime    String   @map("end_time")
  isBreak    Boolean  @default(false) @map("is_break")
  isLabBlock Boolean  @default(false) @map("is_lab_block")

  tenant           Tenant?           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  timetableRules   TimetableRule[]
  classOccurrences ClassOccurrence[]

  @@unique([tenantId, slotNumber])
  @@map("time_slots")
}

// ==============================================================================
// LEGACY ATTENDANCE MODEL (AcademicClass -> Session -> Attendance)
// Being retired. New work uses CourseSection -> TimetableRule -> ClassOccurrence
// -> AttendanceRecord, further down in this file.
// ==============================================================================

/// LEGACY. A subject taught by one teacher. Replaced by CourseSection.
model AcademicClass {
  id          String   @id @default(uuid())
  tenantId    String?  @map("tenant_id")
  name        String
  subjectId   String   @map("subject_id")
  teacherId   String   @map("teacher_id")
  classroomId    String?  @map("classroom_id")
  academicYearId String?  @map("academic_year_id")
  semester       Int?
  batch          String?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  tenant       Tenant?       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  teacher      Teacher       @relation(fields: [teacherId], references: [id], onDelete: Restrict)
  subject      Subject       @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  classroom    Classroom?    @relation(fields: [classroomId], references: [id], onDelete: SetNull)
  academicYear AcademicYear? @relation(fields: [academicYearId], references: [id], onDelete: SetNull)
  geofence     Geofence?
  enrollments  Enrollment[]
  sessions     Session[]

  @@index([tenantId, teacherId, semester])
  @@index([subjectId])
  @@index([classroomId])
  @@index([academicYearId])
  @@map("classes")
}

/// LEGACY. A student's place in an AcademicClass. Replaced by CourseEnrollment.
model Enrollment {
  id              String   @id @default(uuid())
  studentId       String   @map("student_id")
  academicClassId String   @map("academic_class_id")
  enrolledAt      DateTime @default(now()) @map("enrolled_at")

  student       Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  academicClass AcademicClass @relation(fields: [academicClassId], references: [id], onDelete: Cascade)

  @@unique([studentId, academicClassId])
  @@index([academicClassId])
  @@map("enrollments")
}

/// LEGACY. One attendance window opened by a teacher. Replaced by ClassOccurrence.
model Session {
  id              String   @id @default(uuid())
  tenantId        String?  @map("tenant_id")
  academicClassId String   @map("class_id")
  startTime       DateTime @map("start_time")
  endTime         DateTime @map("end_time")
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  tenant        Tenant?       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  academicClass AcademicClass @relation(fields: [academicClassId], references: [id], onDelete: Cascade)
  attendance    Attendance[]

  @@index([academicClassId, isActive])
  @@index([tenantId, startTime])
  @@map("sessions")
}

/// The allowed area for marking attendance. Attached to a CourseSection (current) or an AcademicClass (legacy).
model Geofence {
  id              String   @id @default(uuid())
  academicClassId String?  @unique @map("class_id")
  courseSectionId String?  @unique @map("course_section_id")
  latitude        Float
  longitude       Float
  radiusMeters    Float    @map("radius_meters")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  academicClass AcademicClass? @relation(fields: [academicClassId], references: [id], onDelete: Cascade)
  courseSection CourseSection? @relation(fields: [courseSectionId], references: [id], onDelete: Cascade)

  @@map("geofences")
}

/// LEGACY. One student's mark in a Session, with free-text status. Replaced by AttendanceRecord.
model Attendance {
  id                 String    @id @default(uuid())
  tenantId           String?   @map("tenant_id")
  sessionId          String    @map("session_id")
  studentId          String    @map("student_id")
  status             String
  faceScore          Float     @map("face_score")
  livenessScore      Float     @map("liveness_score")
  backgroundScore    Float     @map("background_score")
  finalAiScore       Float     @map("final_ai_score")
  gpsLatitude        Float     @map("gps_latitude")
  gpsLongitude       Float     @map("gps_longitude")
  evidencePhotoUrl   String?   @map("evidence_photo_url")
  remarks            String?
  studentNote        String?   @map("student_note")
  reviewedBy         String?   @map("reviewed_by")
  reviewedAt         DateTime? @map("reviewed_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  tenant  Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, sessionId])
  @@index([tenantId, createdAt])
  @@index([studentId, createdAt])
  @@index([sessionId, status])
  @@map("attendance")
}

// ==============================================================================
// LEAVES, DEVICES, LICENSES, AUDIT & NOTIFICATIONS
// ==============================================================================

model LeaveRequest {
  id           String      @id @default(uuid())
  tenantId     String?     @map("tenant_id")
  studentId    String      @map("student_id")
  startDate    DateTime    @map("start_date")
  endDate      DateTime    @map("end_date")
  reason       String
  documentUrl  String?     @map("document_url")
  status       LeaveStatus @default(PENDING)
  approvedBy   String?     @map("approved_by")
  approverNote String?     @map("approver_note")
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  tenant  Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, status, startDate, endDate])
  @@index([tenantId, status])
  @@map("leave_requests")
}

model DeviceChangeRequest {
  id            String             @id @default(uuid())
  tenantId      String?            @map("tenant_id")
  studentId     String             @map("student_id")
  newDeviceUuid String             @map("new_device_uuid")
  reason        String?
  status        DeviceChangeStatus @default(PENDING)
  approvedBy    String?            @map("approved_by")
  createdAt     DateTime           @default(now()) @map("created_at")
  updatedAt     DateTime           @updatedAt @map("updated_at")

  tenant  Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, status])
  @@index([tenantId, status])
  @@map("device_change_requests")
}

model LicenseRequest {
  id             String               @id @default(uuid())
  tenantId       String?              @map("tenant_id")
  requestedById  String               @map("requested_by_id")
  requestedCount Int                  @map("requested_count")
  status         LicenseRequestStatus @default(PENDING)
  processedById  String?              @map("processed_by_id")
  processedAt    DateTime?            @map("processed_at")
  createdAt      DateTime             @default(now()) @map("created_at")
  updatedAt      DateTime             @updatedAt @map("updated_at")

  tenant      Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  requestedBy User    @relation("LicenseRequester", fields: [requestedById], references: [id], onDelete: Cascade)
  processedBy User?   @relation("LicenseProcessor", fields: [processedById], references: [id], onDelete: SetNull)

  @@index([tenantId, status])
  @@map("license_requests")
}

model AuditLog {
  id          String   @id @default(uuid())
  tenantId    String?  @map("tenant_id")
  actorId     String?  @map("actor_id")
  actor       String
  eventType   String   @map("event_type")
  severity    String
  target      String
  description String
  ipAddress   String?  @map("ip_address")
  metadata    Json?
  timestamp   DateTime @default(now())

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, timestamp])
  @@index([eventType, timestamp])
  @@map("audit_logs")
}

model SystemConfiguration {
  id                              String   @id @default(uuid())
  tenantId                        String?  @unique @map("tenant_id")
  isFaceRecognitionEnabled        Boolean  @default(true) @map("is_face_recognition_enabled")
  isGpsVerificationEnabled        Boolean  @default(true) @map("is_gps_verification_enabled")
  isAiBackgroundValidationEnabled Boolean  @default(true) @map("is_ai_background_validation_enabled")
  geofenceRadiusMeters            Int      @default(50) @map("geofence_radius_meters")
  updatedAt                       DateTime @updatedAt @map("updated_at")

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("system_configurations")
}

model Notification {
  id        String   @id @default(uuid())
  tenantId  String?  @map("tenant_id")
  userId    String?  @map("user_id")
  role      Role?
  title     String
  message   String
  type      String   @default("info")
  category  String   @default("system")
  link      String?
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([userId, isRead])
  @@map("notifications")
}

// ==============================================================================
// CURRENT ATTENDANCE MODEL
//   CourseSection -> TimetableRule -> ClassOccurrence -> AttendanceRecord
// A section is one subject taught to one class. A rule is its weekly slot. An
// occurrence is one real, dated lesson. A record is one student's mark in it.
// ==============================================================================

/// An academic year, with the attendance minimum and window length that apply to it.
model AcademicYear {
  id                    String               @id @default(uuid())
  tenantId              String               @map("tenant_id")
  name                  String
  startDate             DateTime             @map("start_date") @db.Date
  endDate               DateTime             @map("end_date") @db.Date
  attendanceStartDate   DateTime?            @map("attendance_start_date") @db.Date
  attendanceEndDate     DateTime?            @map("attendance_end_date") @db.Date
  minAttendancePct      Float                @default(75.0) @map("min_attendance_pct")
  saturdayEnabled       Boolean              @default(false) @map("saturday_enabled")
  verificationWindowMin Int                  @default(60) @map("verification_window_min")
  status                AcademicPeriodStatus @default(PLANNING)
  createdAt             DateTime             @default(now()) @map("created_at")
  updatedAt             DateTime             @updatedAt @map("updated_at")

  tenant         Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  calendarEvents AcademicCalendarEvent[]
  courseSections CourseSection[]
  classes        AcademicClass[]
  semesters      Semester[]

  @@unique([tenantId, name])
  @@index([tenantId, status])
  @@map("academic_years")
}

/// A holiday, exam day or timetable override. Holidays are left out of attendance percentages.
model AcademicCalendarEvent {
  id                  String            @id @default(uuid())
  tenantId            String            @map("tenant_id")
  academicYearId      String            @map("academic_year_id")
  title               String
  date                DateTime          @db.Date
  eventType           CalendarEventType @map("event_type")
  affectsAllCourses   Boolean           @default(true) @map("affects_all_courses")
  substituteDayOfWeek Int?              @map("substitute_day_of_week")
  description         String?
  createdAt           DateTime          @default(now()) @map("created_at")

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  @@unique([tenantId, academicYearId, date, eventType])
  @@index([tenantId, date])
  @@map("academic_calendar_events")
}

/// One subject taught to one class in one academic year. This is what a teacher sees as "my class".
model CourseSection {
  id             String   @id @default(uuid())
  tenantId       String   @map("tenant_id")
  academicYearId String   @map("academic_year_id")
  subjectId      String   @map("subject_id")
  departmentId   String?  @map("department_id")
  name           String
  batch          String?
  defaultRoomId  String?  @map("default_room_id")
  classTermId    String?  @map("class_term_id")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  tenant         Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  classTerm      ClassTerm?         @relation(fields: [classTermId], references: [id], onDelete: SetNull)
  academicYear   AcademicYear       @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  subject        Subject            @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  department     Department?        @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  defaultRoom    Classroom?         @relation(fields: [defaultRoomId], references: [id], onDelete: SetNull)
  faculties      CourseFaculty[]
  enrollments    CourseEnrollment[]
  timetableRules TimetableRule[]
  occurrences    ClassOccurrence[]
  geofence       Geofence?

  @@unique([academicYearId, subjectId, name, batch])
  @@index([tenantId, academicYearId])
  @@index([classTermId])
  @@map("course_sections")
}

/// A teacher assigned to a CourseSection. isPrimary marks the main teacher.
model CourseFaculty {
  id              String   @id @default(uuid())
  courseSectionId String   @map("course_section_id")
  teacherId       String   @map("teacher_id")
  isPrimary       Boolean  @default(false) @map("is_primary")
  roleDescription String?  @map("role_description")
  assignedAt      DateTime @default(now()) @map("assigned_at")

  courseSection CourseSection @relation(fields: [courseSectionId], references: [id], onDelete: Cascade)
  teacher       Teacher       @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([courseSectionId, teacherId])
  @@map("course_faculties")
}

/// A student taking a CourseSection. Ended enrollments keep their history (endedAt is set).
model CourseEnrollment {
  id              String   @id @default(uuid())
  courseSectionId String   @map("course_section_id")
  studentId       String   @map("student_id")
  status          CourseEnrollmentStatus @default(ACTIVE)
  source          EnrollmentSource @default(MANUAL)
  enrolledAt      DateTime @default(now()) @map("enrolled_at")
  endedAt         DateTime? @map("ended_at")

  courseSection CourseSection @relation(fields: [courseSectionId], references: [id], onDelete: Cascade)
  student       Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([courseSectionId, studentId])
  @@index([studentId])
  @@map("course_enrollments")
}

/// A weekly repeating slot for a CourseSection (for example, Mondays in period 2).
model TimetableRule {
  id              String   @id @default(uuid())
  tenantId        String   @map("tenant_id")
  courseSectionId String   @map("course_section_id")
  timeSlotId      String   @map("time_slot_id")
  classroomId     String?  @map("classroom_id")
  teacherId       String?  @map("teacher_id")
  dayOfWeek       Int      @map("day_of_week")
  effectiveFrom   DateTime @map("effective_from") @db.Date
  effectiveUntil  DateTime @map("effective_until") @db.Date
  isActive        Boolean  @default(true) @map("is_active")

  courseSection CourseSection     @relation(fields: [courseSectionId], references: [id], onDelete: Cascade)
  timeSlot      TimeSlot          @relation(fields: [timeSlotId], references: [id], onDelete: Restrict)
  classroom     Classroom?        @relation(fields: [classroomId], references: [id], onDelete: SetNull)
  teacher       Teacher?          @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  occurrences   ClassOccurrence[]

  @@unique([courseSectionId, timeSlotId, dayOfWeek])
  @@index([tenantId, dayOfWeek, timeSlotId])
  @@map("timetable_rules")
}

/// One dated lesson of a CourseSection. The teacher opens a verification window on it
/// and students mark attendance until the window closes or the teacher locks it.
model ClassOccurrence {
  id                  String           @id @default(uuid())
  tenantId            String           @map("tenant_id")
  courseSectionId     String           @map("course_section_id")
  timetableRuleId     String?          @map("timetable_rule_id")
  date                DateTime         @db.Date
  timeSlotId          String           @map("time_slot_id")
  classroomId         String?          @map("classroom_id")
  facultyId           String           @map("faculty_id")
  substituteFacultyId String?          @map("substitute_faculty_id")
  status              OccurrenceStatus @default(SCHEDULED)
  cancellationReason  String?          @map("cancellation_reason")
  topicCovered        String?          @map("topic_covered")
  isAttendanceLocked  Boolean          @default(false) @map("is_attendance_locked")
  verificationActive  Boolean          @default(false) @map("verification_active")
  verificationExpires DateTime?        @map("verification_expires")
  conductedAt         DateTime?        @map("conducted_at")
  createdAt           DateTime         @default(now()) @map("created_at")
  updatedAt           DateTime         @updatedAt @map("updated_at")

  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  courseSection     CourseSection      @relation(fields: [courseSectionId], references: [id], onDelete: Cascade)
  timetableRule     TimetableRule?     @relation(fields: [timetableRuleId], references: [id], onDelete: SetNull)
  timeSlot          TimeSlot           @relation(fields: [timeSlotId], references: [id], onDelete: Restrict)
  classroom         Classroom?         @relation(fields: [classroomId], references: [id], onDelete: SetNull)
  faculty           Teacher            @relation("FacultyOccurrences", fields: [facultyId], references: [id], onDelete: Restrict)
  substituteFaculty Teacher?           @relation("SubstituteOccurrences", fields: [substituteFacultyId], references: [id], onDelete: SetNull)
  attendanceRecords AttendanceRecord[]

  @@unique([courseSectionId, date, timeSlotId])
  @@index([tenantId, date])
  @@index([facultyId, date])
  @@index([tenantId, facultyId, date])
  @@map("class_occurrences")
}

/// One student's attendance in one ClassOccurrence (unique per pair). Scores are null when a
/// check did not run; a missing check is never recorded as 0 or 1.
model AttendanceRecord {
  id               String           @id @default(uuid())
  tenantId         String           @map("tenant_id")
  occurrenceId     String           @map("occurrence_id")
  studentId        String           @map("student_id")
  status           AttendanceStatus @default(ABSENT)
  method           AttendanceMethod @default(MANUAL_REGISTER)
  faceScore        Float?           @map("face_score")
  livenessScore    Float?           @map("liveness_score")
  gpsLatitude      Float?           @map("gps_latitude")
  gpsLongitude     Float?           @map("gps_longitude")
  evidencePhotoUrl String?          @map("evidence_photo_url")
  remarks          String?
  verifiedAt       DateTime         @default(now()) @map("verified_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  tenant     Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  occurrence ClassOccurrence      @relation(fields: [occurrenceId], references: [id], onDelete: Cascade)
  student    Student              @relation(fields: [studentId], references: [id], onDelete: Cascade)
  auditLogs  AttendanceAuditLog[]

  @@unique([occurrenceId, studentId])
  @@index([tenantId, verifiedAt])
  @@index([studentId, status])
  @@map("attendance_records")
}

/// Every change to an AttendanceRecord: who changed it, from what, to what, and why.
model AttendanceAuditLog {
  id                 String           @id @default(uuid())
  attendanceRecordId String           @map("attendance_record_id")
  previousStatus     AttendanceStatus @map("previous_status")
  newStatus          AttendanceStatus @map("new_status")
  changedById        String           @map("changed_by_id")
  reason             String
  ipAddress          String?          @map("ip_address")
  timestamp          DateTime         @default(now())

  attendanceRecord AttendanceRecord @relation(fields: [attendanceRecordId], references: [id], onDelete: Cascade)
  changedBy        User             @relation(fields: [changedById], references: [id], onDelete: Restrict)

  @@index([attendanceRecordId])
  @@map("attendance_audit_logs")
}

enum StudentGroupStatus {
  ACTIVE
  GRADUATED
  ARCHIVED
}

enum ClassMemberStatus {
  ACTIVE
  DETAINED
  TRANSFERRED
  PROMOTED
}

enum EnrollmentSource {
  CLASS
  BACKLOG
  MANUAL
}

// ==============================================================================
// CLASSES (a department batch taking a semester)
//   Batch -> StudentGroup -> ClassTerm (per semester) -> ClassMember (students)
// ==============================================================================

/// A semester within an academic year (for example, semester 3 of 2026-27).
model Semester {
  id             String   @id @default(uuid())
  tenantId       String   @map("tenant_id")
  academicYearId String   @map("academic_year_id")
  number         Int
  startDate      DateTime @map("start_date") @db.Date
  endDate        DateTime @map("end_date") @db.Date
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  classTerms   ClassTerm[]

  @@unique([tenantId, academicYearId, number])
  @@map("semesters")
}

/// A class's permanent identity within a department, carried across semesters.
model StudentGroup {
  id            String             @id @default(uuid())
  tenantId      String             @map("tenant_id")
  departmentId  String             @map("department_id")
  batch         String
  batchId       String?            @unique @map("batch_id")
  status        StudentGroupStatus @default(ACTIVE)
  createdAt     DateTime           @default(now()) @map("created_at")
  updatedAt     DateTime           @updatedAt @map("updated_at")

  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  department Department  @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  batchRef   Batch?      @relation(fields: [batchId], references: [id], onDelete: Restrict)
  classTerms ClassTerm[]

  @@unique([tenantId, departmentId, batch])
  @@index([tenantId, status])
  @@map("student_groups")
}

enum BatchStatus {
  ACTIVE
  ARCHIVED
}

/// A department's division and batch number, with a short code such as CE-A-1.
model Batch {
  id           String      @id @default(uuid())
  tenantId     String      @map("tenant_id")
  departmentId String      @map("department_id")
  section      String
  number       Int
  code         String
  status       BatchStatus @default(ACTIVE)
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  department    Department     @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  students      Student[]
  studentGroup  StudentGroup?

  @@unique([tenantId, departmentId, section, number])
  @@unique([tenantId, code])
  @@index([tenantId, departmentId])
  @@map("batches")
}

/// A StudentGroup in one Semester. Its subjects (CourseSections) and students (ClassMembers) hang off this.
model ClassTerm {
  id         String   @id @default(uuid())
  tenantId   String   @map("tenant_id")
  groupId    String   @map("group_id")
  semesterId String   @map("semester_id")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  group          StudentGroup    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  semester       Semester        @relation(fields: [semesterId], references: [id], onDelete: Restrict)
  members        ClassMember[]
  courseSections CourseSection[]

  @@unique([groupId, semesterId])
  @@index([tenantId, semesterId])
  @@map("class_terms")
}

/// A student's place in a ClassTerm. Moves, detentions and promotions close the row instead of deleting it.
model ClassMember {
  id          String            @id @default(uuid())
  tenantId    String            @map("tenant_id")
  classTermId String            @map("class_term_id")
  studentId   String            @map("student_id")
  status      ClassMemberStatus @default(ACTIVE)
  joinedAt    DateTime          @default(now()) @map("joined_at")
  leftAt      DateTime?         @map("left_at")
  reason      String?
  createdAt   DateTime          @default(now()) @map("created_at")

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  classTerm ClassTerm @relation(fields: [classTermId], references: [id], onDelete: Cascade)
  student   Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([classTermId, studentId])
  @@index([tenantId, studentId, status])
  @@map("class_members")
}


