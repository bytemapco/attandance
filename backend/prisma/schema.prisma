datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

generator client {
  provider             = "prisma-client-py"
  interface            = "asyncio"
  recursive_type_depth = 5
  previewFeatures      = ["postgresqlExtensions"]
}


// ==============================================================================
// ENUMS
// ==============================================================================

enum Role {
  STUDENT
  TEACHER
  ADMIN
  SUPER_ADMIN
  TENANT_ADMIN
}

enum Gender {
  M
  F
  O
}

enum CourseEnrollmentStatus {
  ACTIVE
  DROPPED
}

enum TenantType {
  COLLEGE
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  TRIAL
  EXPIRED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  FLAGGED
  APPROVED
  EXCUSED
  LATE
}

enum AttendanceMethod {
  AI_BIOMETRIC
  QR_CODE
  SMART_PASS_OFFLINE
  MANUAL_OVERRIDE
  MANUAL_REGISTER
  SYSTEM_EXCUSED
}


enum OccurrenceStatus {
  SCHEDULED
  CONDUCTED
  CANCELLED
  RESCHEDULED
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum DeviceStatus {
  ACTIVE
  REVOKED
}

enum DeviceChangeStatus {
  PENDING
  APPROVED
  REJECTED
}

enum LicenseRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

// ==============================================================================
// TENANTS & USERS
// ==============================================================================

/// A college or university using SAHAJ. Everything else belongs to one tenant.
model Tenant {
  id           String       @id @default(uuid())
  slug         String       @unique
  name         String
  type         TenantType   @default(COLLEGE)
  status       TenantStatus @default(ACTIVE)
  licenseCount Int          @default(0) @map("license_count")
  settings     Json?        @default("{}")
  config       Json?
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  users           User[]
  students        Student[]
  teachers        Teacher[]
  departments     Department[]
  subjects        Subject[]
  classrooms      Classroom[]
  designations    Designation[]
  auditLogs       AuditLog[]
  licenseRequests LicenseRequest[]
  notifications   Notification[]
  announcements   Announcement[]
  systemConfig    SystemConfiguration?

  courseSections    CourseSection[]
  classOccurrences  ClassOccurrence[]
  attendanceRecords AttendanceRecord[]
  studentGroups     StudentGroup[]
  batches           Batch[]
  academicLevels    AcademicLevel[]
  classMembers      ClassMember[]

  leaveRequests        LeaveRequest[]
  deviceChangeRequests DeviceChangeRequest[]
  biometricConsents    BiometricConsent[]

  agentConversations AgentConversation[]
  agentProposals     AgentProposal[]

  @@index([status])
  @@map("tenants")
}

/// A login. Students and teachers each have one User plus a Student or Teacher profile.
model User {
  id                 String    @id @default(uuid())
  tenantId           String?   @map("tenant_id")
  email              String    @unique
  hashedPassword     String    @map("hashed_password")
  role               Role      @default(STUDENT)
  isActive           Boolean   @default(true) @map("is_active")
  mustChangePassword Boolean   @default(false) @map("must_change_password")
  lastLoginAt        DateTime? @map("last_login_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  tenant                     Tenant?          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student                    Student?
  teacher                    Teacher?
  notifications              Notification[]
  announcementsSent          Announcement[]   @relation("AnnouncementSender")
  announcementReads          AnnouncementRead[]
  licenseRequestsAsRequester LicenseRequest[] @relation("LicenseRequester")
  licenseRequestsAsProcessor LicenseRequest[] @relation("LicenseProcessor")
  attendanceAudits           AttendanceAuditLog[]
  lockedOccurrences          ClassOccurrence[] @relation("OccurrenceLockedBy")
  recordedConsents           BiometricConsent[]
  agentConversations         AgentConversation[]
  agentProposals             AgentProposal[]

  @@index([tenantId, role])
  @@index([tenantId, isActive])
  @@map("users")
}

model Student {
  id               String    @id @default(uuid())
  tenantId         String    @map("tenant_id")
  userId           String    @unique @map("user_id")
  departmentId     String    @map("department_id")
  enrollmentNumber String    @map("enrollment_number")
  firstName        String?   @map("first_name")
  lastName         String?   @map("last_name")
  phone            String?   @map("phone")
  gender           Gender?   @map("gender")
  dateOfBirth      DateTime? @map("date_of_birth") @db.Date
  semester         Int?      @map("semester")
  batch            String?   @map("batch")
  batchId          String?   @map("batch_id")
  deviceUuid       String?   @map("device_uuid")
  fcmToken         String?   @map("fcm_token")
  faceEmbedding    Unsupported("vector(128)")? @map("face_embedding")
  currentStreak    Int       @default(0) @map("current_streak")
  highestStreak    Int       @default(0) @map("highest_streak")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  tenant               Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user                 User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  department           Department            @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  batchRef             Batch?                @relation(fields: [batchId], references: [id], onDelete: Restrict)
  biometricConsents    BiometricConsent[]
  leaveRequests        LeaveRequest[]
  deviceChangeRequests DeviceChangeRequest[]
  courseEnrollments    CourseEnrollment[]
  attendanceRecords    AttendanceRecord[]
  classMemberships     ClassMember[]

  @@unique([tenantId, enrollmentNumber])
  @@index([tenantId, departmentId])
  @@index([tenantId, createdAt])
  @@index([semester, batch])
  @@index([batchId])
  @@map("students")
}

model Teacher {
  id              String    @id @default(uuid())
  tenantId        String    @map("tenant_id")
  userId          String    @unique @map("user_id")
  departmentId    String    @map("department_id")
  designationId   String    @map("designation_id")
  employeeId      String    @map("employee_id")
  firstName       String    @map("first_name")
  lastName        String    @map("last_name")
  nameInitials    String?   @map("name_initials")
  phone           String?   @map("phone")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  tenant                Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user                  User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  department            Department            @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  designation           Designation           @relation(fields: [designationId], references: [id], onDelete: Restrict)
  facultyOccurrences    ClassOccurrence[]     @relation("FacultyOccurrences")
  substituteOccurrences ClassOccurrence[]     @relation("SubstituteOccurrences")
  courseFaculties       CourseFaculty[]
  timetableRules        TimetableRule[]

  @@unique([tenantId, employeeId])
  @@index([tenantId, departmentId])
  @@map("teachers")
}

// ==============================================================================
// ACADEMIC SETUP (departments, subjects, rooms, periods)
// ==============================================================================

model Department {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  code        String
  name        String
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant   Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  teachers Teacher[]
  students Student[]
  subjects Subject[]
  courseSections CourseSection[]
  studentGroups  StudentGroup[]
  batches        Batch[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("departments")
}

model Designation {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  code        String
  name        String
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  teachers Teacher[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("designations")
}

model Subject {
  id           String   @id @default(uuid())
  tenantId     String   @map("tenant_id")
  departmentId String?  @map("department_id")
  code         String
  name         String
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  department      Department?      @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  courseSections  CourseSection[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([departmentId])
  @@map("subjects")
}

model Classroom {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  name      String
  capacity  Int?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant           Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  courseSections   CourseSection[]
  occurrences      ClassOccurrence[]
  timetableRules   TimetableRule[]

  @@index([tenantId])
  @@map("classrooms")
}

// ==============================================================================
// LEAVES, DEVICES, LICENSES, AUDIT & NOTIFICATIONS
// ==============================================================================

model LeaveRequest {
  id           String      @id @default(uuid())
  tenantId     String      @map("tenant_id")
  studentId    String      @map("student_id")
  startDate    DateTime    @map("start_date")
  endDate      DateTime    @map("end_date")
  reason       String
  documentUrl  String?     @map("document_url")
  status       LeaveStatus @default(PENDING)
  approvedBy   String?     @map("approved_by")
  approverNote String?     @map("approver_note")
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, status, startDate, endDate])
  @@index([tenantId, status])
  @@map("leave_requests")
}

model DeviceChangeRequest {
  id            String             @id @default(uuid())
  tenantId      String             @map("tenant_id")
  studentId     String             @map("student_id")
  newDeviceUuid String             @map("new_device_uuid")
  reason        String?
  status        DeviceChangeStatus @default(PENDING)
  approvedBy    String?            @map("approved_by")
  createdAt     DateTime           @default(now()) @map("created_at")
  updatedAt     DateTime           @updatedAt @map("updated_at")

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, status])
  @@index([tenantId, status])
  @@map("device_change_requests")
}

model LicenseRequest {
  id             String               @id @default(uuid())
  tenantId       String               @map("tenant_id")
  requestedById  String               @map("requested_by_id")
  requestedCount Int                  @map("requested_count")
  status         LicenseRequestStatus @default(PENDING)
  processedById  String?              @map("processed_by_id")
  processedAt    DateTime?            @map("processed_at")
  createdAt      DateTime             @default(now()) @map("created_at")
  updatedAt      DateTime             @updatedAt @map("updated_at")

  tenant      Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  requestedBy User    @relation("LicenseRequester", fields: [requestedById], references: [id], onDelete: Cascade)
  processedBy User?   @relation("LicenseProcessor", fields: [processedById], references: [id], onDelete: SetNull)

  @@index([tenantId, status])
  @@map("license_requests")
}

model AuditLog {
  id          String   @id @default(uuid())
  tenantId    String?  @map("tenant_id")
  actorId     String?  @map("actor_id")
  actor       String
  eventType   String   @map("event_type")
  severity    String
  target      String
  description String
  ipAddress   String?  @map("ip_address")
  metadata    Json?
  timestamp   DateTime @default(now())

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, timestamp])
  @@index([eventType, timestamp])
  @@map("audit_logs")
}

model SystemConfiguration {
  id                              String   @id @default(uuid())
  tenantId                        String?  @unique @map("tenant_id")
  isFaceRecognitionEnabled        Boolean  @default(true) @map("is_face_recognition_enabled")
  isGpsVerificationEnabled        Boolean  @default(true) @map("is_gps_verification_enabled")
  isAiBackgroundValidationEnabled Boolean  @default(true) @map("is_ai_background_validation_enabled")
  campusLatitude                  Float?   @map("campus_latitude")
  campusLongitude                 Float?   @map("campus_longitude")
  geofenceRadiusMeters            Int      @default(50) @map("geofence_radius_meters")
  minAttendancePct                Float    @default(75.0) @map("min_attendance_pct")
  verificationWindowMin           Int      @default(60) @map("verification_window_min")
  saturdayEnabled                 Boolean  @default(false) @map("saturday_enabled")
  updatedAt                       DateTime @updatedAt @map("updated_at")

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("system_configurations")
}

model Notification {
  id        String   @id @default(uuid())
  tenantId  String?  @map("tenant_id")
  userId    String?  @map("user_id")
  role      Role?
  title     String
  message   String
  type      String   @default("info")
  category  String   @default("system")
  link      String?
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([userId, isRead])
  @@map("notifications")
}

enum AnnouncementAudience {
  ALL
  STUDENT
  TEACHER
  ADMIN
}

/// A message to a group of people, from the platform owner or from an institution. It is stored once; who has
/// read or removed it is in announcement_reads. A null tenantId means every institution.
model Announcement {
  id            String               @id @default(uuid())
  tenantId      String?              @map("tenant_id")
  senderId      String?              @map("sender_id")
  audience      AnnouncementAudience @default(ALL)
  title         String
  message       String
  type          String               @default("info")
  category      String               @default("system")
  link          String?
  /// People can see it from this moment. In the future for a scheduled announcement.
  publishAt     DateTime             @default(now()) @map("publish_at")
  /// Set when connected people were told it exists. The worker finds announcements that are due but not pushed.
  pushedAt      DateTime?            @map("pushed_at")
  /// How many people it was meant for when it was sent.
  audienceCount Int                  @default(0) @map("audience_count")
  createdAt     DateTime             @default(now()) @map("created_at")

  tenant Tenant?              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sender User?                @relation("AnnouncementSender", fields: [senderId], references: [id], onDelete: SetNull)
  reads  AnnouncementRead[]

  @@index([tenantId, publishAt])
  @@index([pushedAt, publishAt])
  @@map("announcements")
}

/// One row per person who has read or removed an announcement. No row means unread.
model AnnouncementRead {
  announcementId String    @map("announcement_id")
  userId         String    @map("user_id")
  readAt         DateTime  @default(now()) @map("read_at")
  /// The person removed it from their list.
  dismissedAt    DateTime? @map("dismissed_at")

  announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([announcementId, userId])
  @@index([userId])
  @@map("announcement_reads")
}

// ==============================================================================
// CURRENT ATTENDANCE MODEL
//   CourseSection -> TimetableRule -> ClassOccurrence -> AttendanceRecord
// A section is one subject taught to one class. A rule is its weekly slot. An
// occurrence is one real, dated lesson. A record is one student's mark in it.
// ==============================================================================

/// One subject taught to one class. This is what a teacher sees as "my class".
model CourseSection {
  id             String   @id @default(uuid())
  tenantId       String   @map("tenant_id")
  subjectId      String   @map("subject_id")
  departmentId   String?  @map("department_id")
  name           String
  batch          String?
  defaultRoomId  String?  @map("default_room_id")
  groupId        String?  @map("group_id")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  tenant         Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  group          StudentGroup?      @relation(fields: [groupId], references: [id], onDelete: SetNull)
  subject        Subject            @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  department     Department?        @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  defaultRoom    Classroom?         @relation(fields: [defaultRoomId], references: [id], onDelete: SetNull)
  faculties      CourseFaculty[]
  enrollments    CourseEnrollment[]
  timetableRules TimetableRule[]
  occurrences    ClassOccurrence[]

  @@unique([tenantId, subjectId, name, batch])
  @@index([tenantId])
  @@index([groupId])
  @@map("course_sections")
}

/// A teacher assigned to a CourseSection. isPrimary marks the main teacher.
model CourseFaculty {
  id              String   @id @default(uuid())
  courseSectionId String   @map("course_section_id")
  teacherId       String   @map("teacher_id")
  isPrimary       Boolean  @default(false) @map("is_primary")
  roleDescription String?  @map("role_description")
  assignedAt      DateTime @default(now()) @map("assigned_at")

  courseSection CourseSection @relation(fields: [courseSectionId], references: [id], onDelete: Cascade)
  teacher       Teacher       @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([courseSectionId, teacherId])
  @@map("course_faculties")
}

/// A student taking a CourseSection. Ended enrollments keep their history (endedAt is set).
model CourseEnrollment {
  id              String   @id @default(uuid())
  courseSectionId String   @map("course_section_id")
  studentId       String   @map("student_id")
  status          CourseEnrollmentStatus @default(ACTIVE)
  source          EnrollmentSource @default(MANUAL)
  enrolledAt      DateTime @default(now()) @map("enrolled_at")
  endedAt         DateTime? @map("ended_at")

  courseSection CourseSection @relation(fields: [courseSectionId], references: [id], onDelete: Cascade)
  student       Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([courseSectionId, studentId])
  @@index([studentId])
  @@map("course_enrollments")
}

/// A weekly repeating class for a CourseSection (for example, Mondays 09:00 to 10:00).
model TimetableRule {
  id              String    @id @default(uuid())
  tenantId        String    @map("tenant_id")
  courseSectionId String    @map("course_section_id")
  classroomId     String?   @map("classroom_id")
  teacherId       String?   @map("teacher_id")
  dayOfWeek       Int       @map("day_of_week")
  /// Clock times as "HH:MM", 24 hour.
  startTime       String    @map("start_time")
  endTime         String    @map("end_time")
  effectiveFrom   DateTime  @map("effective_from") @db.Date
  /// Null means the rule runs until it is removed.
  effectiveUntil  DateTime? @map("effective_until") @db.Date
  isActive        Boolean   @default(true) @map("is_active")

  courseSection CourseSection     @relation(fields: [courseSectionId], references: [id], onDelete: Cascade)
  classroom     Classroom?        @relation(fields: [classroomId], references: [id], onDelete: SetNull)
  teacher       Teacher?          @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  occurrences   ClassOccurrence[]

  @@unique([courseSectionId, dayOfWeek, startTime])
  @@index([tenantId, dayOfWeek, startTime])
  @@map("timetable_rules")
}

/// One dated lesson of a CourseSection. The teacher opens a verification window on it
/// and students mark attendance until the window closes or the teacher locks it.
model ClassOccurrence {
  id                  String           @id @default(uuid())
  tenantId            String           @map("tenant_id")
  courseSectionId     String           @map("course_section_id")
  timetableRuleId     String?          @map("timetable_rule_id")
  date                DateTime         @db.Date
  /// Clock times as "HH:MM", 24 hour.
  startTime           String           @map("start_time")
  endTime             String           @map("end_time")
  classroomId         String?          @map("classroom_id")
  facultyId           String           @map("faculty_id")
  substituteFacultyId String?          @map("substitute_faculty_id")
  status              OccurrenceStatus @default(SCHEDULED)
  cancellationReason  String?          @map("cancellation_reason")
  topicCovered        String?          @map("topic_covered")
  isAttendanceLocked  Boolean          @default(false) @map("is_attendance_locked")
  lockedAt            DateTime?        @map("locked_at")
  lockedById          String?          @map("locked_by_id")
  verificationActive  Boolean          @default(false) @map("verification_active")
  verificationExpires DateTime?        @map("verification_expires")
  conductedAt         DateTime?        @map("conducted_at")
  createdAt           DateTime         @default(now()) @map("created_at")
  updatedAt           DateTime         @updatedAt @map("updated_at")

  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  courseSection     CourseSection      @relation(fields: [courseSectionId], references: [id], onDelete: Cascade)
  timetableRule     TimetableRule?     @relation(fields: [timetableRuleId], references: [id], onDelete: SetNull)
  classroom         Classroom?         @relation(fields: [classroomId], references: [id], onDelete: SetNull)
  faculty           Teacher            @relation("FacultyOccurrences", fields: [facultyId], references: [id], onDelete: Restrict)
  substituteFaculty Teacher?           @relation("SubstituteOccurrences", fields: [substituteFacultyId], references: [id], onDelete: SetNull)
  lockedBy          User?              @relation("OccurrenceLockedBy", fields: [lockedById], references: [id], onDelete: SetNull)
  attendanceRecords AttendanceRecord[]

  @@unique([courseSectionId, date, startTime])
  @@index([tenantId, date])
  @@index([facultyId, date])
  @@index([tenantId, facultyId, date])
  @@map("class_occurrences")
}

/// One student's attendance in one ClassOccurrence (unique per pair). Scores are null when a
/// check did not run; a missing check is never recorded as 0 or 1.
model AttendanceRecord {
  id               String           @id @default(uuid())
  tenantId         String           @map("tenant_id")
  occurrenceId     String           @map("occurrence_id")
  studentId        String           @map("student_id")
  status           AttendanceStatus @default(ABSENT)
  method           AttendanceMethod @default(MANUAL_REGISTER)
  faceScore        Float?           @map("face_score")
  livenessScore    Float?           @map("liveness_score")
  gpsLatitude      Float?           @map("gps_latitude")
  gpsLongitude     Float?           @map("gps_longitude")
  evidencePhotoUrl String?          @map("evidence_photo_url")
  remarks          String?
  /// Why the student says a flagged mark is genuine. The teacher sees it when reviewing.
  studentNote      String?          @map("student_note")
  verifiedAt       DateTime         @default(now()) @map("verified_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  tenant     Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  occurrence ClassOccurrence      @relation(fields: [occurrenceId], references: [id], onDelete: NoAction)
  student    Student              @relation(fields: [studentId], references: [id], onDelete: NoAction)
  auditLogs  AttendanceAuditLog[]

  @@unique([occurrenceId, studentId])
  @@index([tenantId, verifiedAt])
  @@index([studentId, status])
  @@map("attendance_records")
}

/// A student's consent to face recognition. One row per grant; revoking sets revokedAt and the
/// row stays as evidence. A student has at most one row with revokedAt null (partial unique index).
/// Consent is stored here, never only in a cache.
model BiometricConsent {
  id            String    @id @default(uuid())
  tenantId      String    @map("tenant_id")
  studentId     String    @map("student_id")
  policyVersion String    @map("policy_version")
  recordedById  String?   @map("recorded_by_id")
  ipAddress     String?   @map("ip_address")
  userAgent     String?   @map("user_agent")
  grantedAt     DateTime  @default(now()) @map("granted_at")
  revokedAt     DateTime? @map("revoked_at")

  tenant     Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student    Student @relation(fields: [studentId], references: [id], onDelete: NoAction)
  recordedBy User?   @relation(fields: [recordedById], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([studentId, grantedAt])
  @@map("biometric_consents")
}

/// Every change to an AttendanceRecord: who changed it, from what, to what, and why.
model AttendanceAuditLog {
  id                 String           @id @default(uuid())
  attendanceRecordId String           @map("attendance_record_id")
  previousStatus     AttendanceStatus @map("previous_status")
  newStatus          AttendanceStatus @map("new_status")
  changedById        String           @map("changed_by_id")
  reason             String
  ipAddress          String?          @map("ip_address")
  timestamp          DateTime         @default(now())

  attendanceRecord AttendanceRecord @relation(fields: [attendanceRecordId], references: [id], onDelete: NoAction)
  changedBy        User             @relation(fields: [changedById], references: [id], onDelete: Restrict)

  @@index([attendanceRecordId])
  @@map("attendance_audit_logs")
}

enum StudentGroupStatus {
  ACTIVE
  ARCHIVED
}

enum ClassMemberStatus {
  ACTIVE
  TRANSFERRED
}

enum EnrollmentSource {
  CLASS
  BACKLOG
  MANUAL
}

// ==============================================================================
// CLASSES (a department batch and its students)
//   Batch -> StudentGroup (the class, with a plain semester number) -> ClassMember (students)
// ==============================================================================

/// The semesters an institution runs (master list, for example Semester 1 to 8). Student and class
/// semester numbers must exist here. `isFinal` marks the last one.
model AcademicLevel {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  number    Int
  name      String
  isFinal   Boolean  @default(false) @map("is_final")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, number])
  @@index([tenantId])
  @@map("academic_levels")
}

/// A class: the students of one batch, and the subjects they take. The semester is a plain number an admin edits.
model StudentGroup {
  id            String             @id @default(uuid())
  tenantId      String             @map("tenant_id")
  departmentId  String             @map("department_id")
  batch         String
  batchId       String?            @unique @map("batch_id")
  semester      Int                @default(1)
  status        StudentGroupStatus @default(ACTIVE)
  createdAt     DateTime           @default(now()) @map("created_at")
  updatedAt     DateTime           @updatedAt @map("updated_at")

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  department     Department      @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  batchRef       Batch?          @relation(fields: [batchId], references: [id], onDelete: Restrict)
  members        ClassMember[]
  courseSections CourseSection[]

  @@unique([tenantId, departmentId, batch])
  @@index([tenantId, status])
  @@map("student_groups")
}

enum BatchStatus {
  ACTIVE
  ARCHIVED
}

/// A department's division and batch number, with a short code such as CE-A-1.
model Batch {
  id           String      @id @default(uuid())
  tenantId     String      @map("tenant_id")
  departmentId String      @map("department_id")
  section      String
  number       Int
  code         String
  status       BatchStatus @default(ACTIVE)
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  department    Department     @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  students      Student[]
  studentGroup  StudentGroup?

  @@unique([tenantId, departmentId, section, number])
  @@unique([tenantId, code])
  @@index([tenantId, departmentId])
  @@map("batches")
}

/// A student's place in a class. Moving or removing a student closes the row instead of deleting it.
model ClassMember {
  id        String            @id @default(uuid())
  tenantId  String            @map("tenant_id")
  groupId   String            @map("group_id")
  studentId String            @map("student_id")
  status    ClassMemberStatus @default(ACTIVE)
  joinedAt  DateTime          @default(now()) @map("joined_at")
  leftAt    DateTime?         @map("left_at")
  reason    String?
  createdAt DateTime          @default(now()) @map("created_at")

  tenant  Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  group   StudentGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  student Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([groupId, studentId])
  @@index([tenantId, studentId, status])
  @@map("class_members")
}



// ==============================================================================
// ASSISTANT (agentic chat for teachers and tenant admins)
// ==============================================================================

model AgentConversation {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  userId    String   @map("user_id")
  title     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant    Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  AgentMessage[]
  proposals AgentProposal[]

  @@index([tenantId, userId, updatedAt])
  @@map("agent_conversations")
}

model AgentMessage {
  id             String   @id @default(uuid())
  tenantId       String   @map("tenant_id")
  conversationId String   @map("conversation_id")
  role           String
  content        String
  events         Json?
  createdAt      DateTime @default(now()) @map("created_at")

  conversation AgentConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("agent_messages")
}

/// One row per tool call the model made, whether it ran, failed or was refused. Never edited.
model AgentToolCall {
  id             String   @id @default(uuid())
  tenantId       String   @map("tenant_id")
  userId         String   @map("user_id")
  conversationId String?  @map("conversation_id")
  toolName       String   @map("tool_name")
  arguments      Json
  outcome        String
  detail         String?
  durationMs     Int      @default(0) @map("duration_ms")
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([tenantId, createdAt])
  @@index([userId, createdAt])
  @@map("agent_tool_calls")
}

/// A change the assistant prepared. Nothing happens until the same user confirms it.
model AgentProposal {
  id             String    @id @default(uuid())
  tenantId       String    @map("tenant_id")
  userId         String    @map("user_id")
  conversationId String?   @map("conversation_id")
  toolName       String    @map("tool_name")
  arguments      Json
  summary        String
  preview        Json
  status         String    @default("PENDING")
  result         Json?
  createdAt      DateTime  @default(now()) @map("created_at")
  expiresAt      DateTime  @map("expires_at")
  decidedAt      DateTime? @map("decided_at")

  tenant       Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation AgentConversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  @@index([tenantId, userId, status])
  @@map("agent_proposals")
}
