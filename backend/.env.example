# ==============================================================================
# Smart Attendance System - Backend Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' for local development or configure these variables
# in your staging/production secret manager.
#
# NEVER COMMIT ACTUAL VALUES OR REAL SECRETS TO VERSION CONTROL.
# ==============================================================================

# --- Application Runtime Environment ---
# Values: development | staging | production
# NOTE: Set to 'staging' or 'production' in deployed environments to enforce strict safeguards.
ENVIRONMENT="development"
DEBUG="false"
LOG_LEVEL="INFO"
PROJECT_NAME="Smart Attendance System API"
API_V1_STR="/api/v1"

# --- Database Configuration (PostgreSQL + pgvector) ---
# Local Dev:  postgresql://postgres:postgres@localhost:5432/smart_attendance?schema=public
# Staging:    postgresql://<staging_user>:<staging_password>@<staging_rds_host>:5432/<staging_db>?schema=public
# Production: Isolated production RDS connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/smart_attendance?schema=public"

# --- Authentication & Security ---
# REQUIRED: Must be a cryptographically secure random string (at least 32 bytes).
# Generate using: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=""
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES="1440"
REFRESH_TOKEN_EXPIRE_DAYS="30"

# --- Distributed Cache & Rate Limiting (Redis) ---
# Local Dev:  redis://localhost:6379/0
# Staging:    redis://:<staging_redis_password>@<redis_host>:6379/0
REDIS_URL="redis://localhost:6379/0"

# --- Object Storage (AWS S3 / MinIO) ---
# For AWS S3: Leave AWS_ENDPOINT_URL empty.
# For Local MinIO: Set AWS_ENDPOINT_URL="http://localhost:9000"
AWS_ENDPOINT_URL=""
AWS_REGION="ap-southeast-2"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
# Staging bucket must be isolated from production (e.g. smart-attendance-staging)
S3_BUCKET_NAME=""

# --- Email & Notifications (SMTP) ---
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_TLS="true"
SMTP_SSL="false"
EMAILS_FROM_EMAIL="noreply@smartattendance.edu"
EMAILS_FROM_NAME="Smart Attendance System"
INVITATION_TOKEN_EXPIRE_HOURS="48"
RESET_TOKEN_EXPIRE_MINUTES="15"

# --- Cross-Origin Resource Sharing (CORS) ---
# Comma-separated list of allowed origins.
# Local Dev:  http://localhost:3000
# Staging:    https://<tailscale-machine-name> or reverse proxy URL
FRONTEND_URL="http://localhost:3000"

# --- AI Hardware Acceleration & Fallback ---
# Target device: 'auto' (detect GPU with fallback), 'cuda' (force GPU), or 'cpu'
AI_DEVICE="auto"
AI_GPU_MEMORY_LIMIT_MB=""
AI_FORCE_CPU_FALLBACK="true"

# --- Third-party Integrations ---
GEMINI_API_KEY=""

# --- Initial Seeding Credentials (Local Dev Only) ---
# Used exclusively by seed scripts in local development. Never use in staging/production.
SUPERADMIN_EMAIL="superadmin@attendance.system"
SUPERADMIN_PASSWORD=""
