# ==============================================================================
# SAHAJ - Backend PRODUCTION environment template (names only, no real values)
# ==============================================================================
# The real file lives in the PRODUCTION_BACKEND_ENV GitHub secret. CD copies it to the server as backend/.env.
# NEVER commit real values.
# Keep this list in step with .env.example and the secret.
# ==============================================================================

ENVIRONMENT="production"
LOG_LEVEL="INFO"

DATABASE_URL="postgresql://sahaj:<password>@127.0.0.1:5432/sahaj"
REDIS_URL="redis://localhost:6379/0"

# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=""
# Set true to refuse requests (503) when the token deny-list in Redis cannot be reached.
TOKEN_REVOCATION_FAIL_CLOSED="false"

AWS_ENDPOINT_URL=""
AWS_DEFAULT_REGION=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
S3_BUCKET_NAME=""

SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
EMAILS_FROM_EMAIL=""
EMAILS_FROM_NAME="SAHAJ"

# Assistant. Empty GEMINI_API_KEY turns it off. Several keys, comma-separated: a key at its limit is skipped for a minute.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.5-flash"
AGENT_MESSAGES_PER_MINUTE="12"
AGENT_DAILY_TOKEN_BUDGET="500000"

# Comma-separated list of allowed CORS origins.
FRONTEND_URL="https://<frontend-domain>"
