# ==============================================================================
# Smart Attendance System - Master Monorepo .gitignore
# Covers: Root, Backend (FastAPI/Python/Prisma), Frontend (Next.js/TS),
# and Mobile (Flutter/Dart/Android/iOS)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Operating System & Filesystem Artifacts
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ------------------------------------------------------------------------------
# 2. Editors, IDEs & Developer Tooling
# ------------------------------------------------------------------------------
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.swp
*.swo
*~
*.bak
*.orig
*.suo
*.ntvs*
*.njsproj
*.sln
.project
.classpath
.cproject
.settings/
*.iml
*.ipr
*.iws

# ------------------------------------------------------------------------------
# 3. Environment Variables & Secret Credentials (CRITICAL)
# ------------------------------------------------------------------------------
# Block all .env files across all subdirectories
.env
.env.*
.env*.local
!.env.example
!.env.*.example

# Credentials, Keys & Certificates
credentials.txt
*-credentials.json
firebase-credentials*.json
google-services*.json
google_services.json
key.properties
*.keystore
*.jks
*.pem
*.key
*.crt
*.cert
*.pfx
*.p12

# ------------------------------------------------------------------------------
# 4. Logs, Runtime & Debug Output
# ------------------------------------------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ------------------------------------------------------------------------------
# 5. Python & Backend (FastAPI, Prisma, Pytest, Ruff, ML)
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Virtual Environments & Build Artifacts
.venv/
venv/
ENV/
env/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
*.egg-info/
.installed.cfg
*.egg
sdist/
var/
wheels/

# Testing, Linting & Coverage Artifacts
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
cov_html/

# Databases & Prisma Client
*.db
*.db-journal
*.sqlite3
prisma/client/
backend/prisma/client/

# Storage & Uploads
uploads/
!uploads/.gitkeep
static/
!static/.gitkeep

# Dynamic AI/ML Model Weights (Allow base models in models directory)
*.pb
*.pt
*.pth
*.pkl
*.joblib
*.onnx
!backend/models/**/*.h5

# ------------------------------------------------------------------------------
# 6. Frontend & Node.js (Next.js, React, Tailwind, Vitest, Playwright)
# ------------------------------------------------------------------------------
node_modules/
.pnp
.pnp.*

# Next.js Build Outputs & Local Deployment
.next/
out/
build/
.vercel/

# TypeScript & Test Caches
*.tsbuildinfo
next-env.d.ts
coverage/
playwright-report/
blob-report/
test-results/
screenshots/
e2e-screenshots/

# ------------------------------------------------------------------------------
# 7. Mobile (Flutter, Dart, Android, iOS)
# ------------------------------------------------------------------------------
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
local.properties

# Flutter / Android Builds & Caches
.gradle/
captures/
.cxx/
gradle-wrapper.jar
gradlew
gradlew.bat
**/android/**/generated/
**/android/app/src/main/res/raw/google_services.json
**/android/app/google-services.json
GeneratedPluginRegistrant.java

# iOS Ephemeral, CocoaPods & Derived Data
**/ios/Flutter/Generated.xcconfig
**/ios/Flutter/flutter_export_environment.sh
**/ios/Flutter/ephemeral/
**/ios/Flutter/App.framework
**/ios/Flutter/Flutter.framework
**/ios/Flutter/Flutter.podspec
**/ios/Flutter/app.flx
**/ios/Flutter/app.zip
**/ios/Flutter/flutter_assets/
**/ios/Pods/
**/ios/.symlinks/
**/ios/Podfile.lock
**/ios/DerivedData/
**/ios/**/GeneratedPluginRegistrant.*
*.xcworkspace/
*.xcuserdatad/
xcuserdata/
app.*.symbols
app.*.map.json

# Mobile Distribution Archives (Avoid untracked build dumps)
*.ipa
*.apk
*.aab

# ------------------------------------------------------------------------------
# 8. Temporary & Knowledge Graph Caches
# ------------------------------------------------------------------------------
temp/
tmp/
.reticle/
.kilo/
graphify-out/
