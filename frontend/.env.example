# ==============================================================================
# Smart Attendance System - Frontend Environment Configuration Template
# ==============================================================================
# Copy this file to '.env.local' for local development.
#
# IMPORTANT: Variables prefixed with NEXT_PUBLIC_ are inlined into the client-side
# JavaScript bundle at build time (npm run build / docker build).
# They are visible to anyone inspecting web requests and browser assets.
# NEVER PUT PRIVATE KEYS, SECRETS, OR PASSWORDS IN NEXT_PUBLIC_ VARIABLES.
# ==============================================================================

# --- Backend API Endpoint ---
# Local Dev:  http://localhost:8000/api/v1
# Staging:    https://<tailscale-hostname>/api/v1 (or /api/v1 if behind a reverse proxy)
# Production: https://api.yourdomain.com/api/v1
NEXT_PUBLIC_API_URL="http://localhost:8000/api/v1"

# --- WebSocket Server Endpoint ---
# Local Dev:  ws://localhost:8000/ws/connect
# Staging:    wss://<tailscale-hostname>/ws/connect (or /ws/connect if behind a reverse proxy)
# Production: wss://api.yourdomain.com/ws/connect
NEXT_PUBLIC_WS_URL="ws://localhost:8000/ws/connect"

# --- Default Tenant Identifier (Optional) ---
# Used as fallback tenant context when no tenant header or user session is present.
NEXT_PUBLIC_DEFAULT_TENANT_ID="default-institution"
