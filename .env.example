# ==============================================================================
# Smart Attendance System - Root Production Environment Template (.env)
# ==============================================================================
# This template is used by Docker Compose on your target deployment VPS.
# Values are populated automatically from AWS Secrets Manager during CD pipeline,
# or configured manually for staging/production.
#
# NEVER COMMIT REAL PRODUCTION SECRETS OR PASSWORDS TO VERSION CONTROL.
# ==============================================================================

# --- Container Image References ---
BACKEND_IMAGE="ghcr.io/your-org-or-username/smart-attendance-backend:latest"
FRONTEND_IMAGE="ghcr.io/your-org-or-username/smart-attendance-frontend:latest"

# --- Host Exposed Ports ---
BACKEND_PORT="8000"
FRONTEND_PORT="3000"

# --- Application Runtime Environment ---
ENVIRONMENT="production"
DEBUG="false"
LOG_LEVEL="INFO"
PROJECT_NAME="Smart Attendance System API"
API_V1_STR="/api/v1"

# --- External AWS Managed Database (PostgreSQL with pgvector) ---
# Example: postgresql://<db_user>:<db_password>@<aws-rds-hostname>:5432/<db_name>?schema=public
DATABASE_URL="postgresql://dbadmin:CHANGE_ME_RDS_PASSWORD@smart-attendance-db.xxxxxx.ap-south-1.rds.amazonaws.com:5432/smart_attendance?schema=public"

# --- Authentication & JWT Security ---
# Generate using: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET="CHANGE_ME_JWT_SECRET_AT_LEAST_32_BYTES_LONG"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES="1440"
REFRESH_TOKEN_EXPIRE_DAYS="30"

# --- Internal Redis Authentication ---
REDIS_PASSWORD="CHANGE_ME_STRONG_REDIS_PASSWORD"

# --- AWS S3 Object Storage Configuration ---
# Leave AWS_ENDPOINT_URL blank when using real AWS S3 in production
AWS_ENDPOINT_URL=""
AWS_REGION="ap-south-1"
AWS_ACCESS_KEY_ID="CHANGE_ME_AWS_ACCESS_KEY_ID"
AWS_SECRET_ACCESS_KEY="CHANGE_ME_AWS_SECRET_ACCESS_KEY"
S3_BUCKET_NAME="smart-attendance-production-storage"

# --- Email Notifications (SMTP) ---
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="noreply@smartattendance.edu"
SMTP_PASSWORD="CHANGE_ME_SMTP_PASSWORD"
SMTP_TLS="true"
SMTP_SSL="false"
EMAILS_FROM_EMAIL="noreply@smartattendance.edu"
EMAILS_FROM_NAME="Smart Attendance System"

# --- CORS Frontend Origins ---
FRONTEND_URL="http://localhost:3000"

# --- AI Acceleration Settings ---
AI_DEVICE="auto"
AI_FORCE_CPU_FALLBACK="true"
AI_GPU_MEMORY_LIMIT_MB=""

# --- Third-party Services ---
GEMINI_API_KEY=""
