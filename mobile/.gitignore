.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.swp
*.swo
*~
*.bak
*.orig
*.iml
*.ipr
*.iws

# ------------------------------------------------------------------------------
# 3. Environment Variables & Secret Credentials (CRITICAL)
# ------------------------------------------------------------------------------
.env
.env.*
.env*.local
!.env.example
!.env.*.example

credentials.txt
*-credentials.json
firebase-credentials*.json
google-services*.json
google_services.json
key.properties
*.keystore
*.jks
*.pem
*.key
*.crt
*.cert
*.pfx
*.p12

# ------------------------------------------------------------------------------
