[Unit]
Description=SAHAJ backend (FastAPI)
After=network-online.target redis-server.service docker.service
Wants=network-online.target

[Service]
Type=simple
User=jarvis
WorkingDirectory=/home/jarvis/SharedDrive/bytemap/attendance/backend
Environment=PYTHONPATH=.
Environment=PORT=8011
ExecStart=/home/jarvis/SharedDrive/bytemap/attendance/backend/venv/bin/uvicorn main:app --host 0.0.0.0 --port 8011 --workers 1
Restart=on-failure
RestartSec=3
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
